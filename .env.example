# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN="8970869943:AAGunknnnGKKgdtxg_pSMy2hlmr6aV34MkM"

# Admin Telegram User IDs (comma separated)
ADMIN_IDS= @EDevil_bot

# Group/Chat ID where submissions are tracked (optional)
# Get it by adding bot to group and sending /myid
TRACKING_CHAT_ID=

# Timezone for daily deadlines (default Asia/Saigon)
TIMEZONE=Asia/Saigon

# Deadline time (24h format) - default 23:59
DEADLINE_HOUR=23
DEADLINE_MINUTE=59

# Ollama Cloud API key for AI-generated speaking topics (optional)
# Create one at https://ollama.com/settings/keys — if unset, the bot uses its built-in topic list
OLLAMA_API_KEY=
# Cloud model to use (default gpt-oss:120b). See https://ollama.com/search?c=cloud
AI_MODEL=gpt-oss:120b